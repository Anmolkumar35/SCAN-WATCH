# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scanewatch?retryWrites=true&w=majority

# Security (64-character random string)
JWT_SECRET=your_super_secret_production_jwt_key_here

# Frontend Application Origin
FRONTEND_URL=https://scane-watch.vercel.app

# Storage Configuration (Local disk default; set 's3' when AWS/Cloudflare R2 is configured)
STORAGE_DRIVER=local

# Optional Cloud Storage Variables (For S3 / Cloudflare R2 / MinIO)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=scanewatch-movies
# S3_REGION=auto